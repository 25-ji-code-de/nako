# Cloudflare Account Configuration
# Required for uploading vectors to Vectorize

CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_KEY=your-global-api-key-here
VECTORIZE_INDEX_NAME=sticker-embeddings

# OpenAI-compatible LLM — production: wrangler secret put; local: .dev.vars
# model:  OPENAI_MODEL_<ID> > OPENAI_MODEL > persona code
# creds:  OPENAI_ENDPOINT_<ID>/OPENAI_API_KEY_<ID> > global
OPENAI_ENDPOINT=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key-here

# OPENAI_MODEL=deepseek-chat
# OPENAI_ENDPOINT_NAKO=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY_NAKO=sk-your-dashscope-key
# OPENAI_ENDPOINT_YUI=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY_YUI=sk-your-dashscope-key
