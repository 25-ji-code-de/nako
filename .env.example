# Cloudflare Account Configuration
# Required for uploading vectors to Vectorize

CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_KEY=your-global-api-key-here
VECTORIZE_INDEX_NAME=sticker-embeddings

# ---------------------------------------------------------------------------
# OpenAI-compatible LLM (provider: "openai" personas)
# Production: npx wrangler secret put <NAME>
# Local: copy into .dev.vars (gitignored)
# ---------------------------------------------------------------------------
OPENAI_ENDPOINT=https://your-openai-compatible-gateway.example
OPENAI_API_KEY=sk-your-key-here

# Optional global model override (debug)
# Priority: OPENAI_MODEL_<ID> > OPENAI_MODEL > persona code default
# OPENAI_MODEL=gpt-4.1-mini

# Optional per-persona models (registration id uppercased — any persona id works)
# OPENAI_MODEL_NAKO=deepseek-v4-flash
# OPENAI_MODEL_ASAGI=glm-5.2-instant
# OPENAI_MODEL_MIKU=gpt-4.1-mini
# OPENAI_MODEL_YUI=glm-4.5-flash

# Optional Workers AI override
# WORKERS_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
