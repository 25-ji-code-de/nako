  },
  "homepage": "https://github.com/25-ji-code-de/nako#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240129.0",
    "dotenv": "^17.2.4",
    "typescript": "^5.3.3",
    "wrangler": "^3.78.0"
  }
